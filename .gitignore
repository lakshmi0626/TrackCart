# TrackCart .gitignore

# Java / Maven
backend/target/
backend/*.log
backend/.flattened-pom.xml
*.class

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local
frontend/.env.*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# IDE and Editors
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# OS Temporary Files
tmp/
temp/
*.tmp

# Environment and secrets
.env
*.pem
*.key
